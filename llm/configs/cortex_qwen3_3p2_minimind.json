{
  "name": "cortex-qwen3-3p2-minimind",
  "backbone": {
    "kind": "hf",
    "model_id": "Qwen/Qwen3-0.6B",
    "tokenizer_id": "Qwen/Qwen3-0.6B",
    "revision": "",
    "local_files_only": false,
    "trust_remote_code": false,
    "dtype": "float32",
    "encoder_layers": 3,
    "decoder_layers": 2,
    "freeze_encoder": true,
    "freeze_decoder": true,
    "lora_rank": 0,
    "lora_alpha": 32.0,
    "lora_dropout": 0.0,
    "lora_targets": ["q_proj", "v_proj"],
    "gradient_checkpointing": true
  },
  "brain": {
    "n_neurons": 1024,
    "edges_per_neuron": 0,
    "weight_mode": "dense",
    "init_from_backbone": true,
    "init_radius": 0.95,
    "regions": 8,
    "local_fraction": 0.6,
    "inhibitory_fraction": 0.2,
    "incoming_norm": 2.0,
    "alpha_min": 0.9,
    "alpha_max": 0.97,
    "ticks_per_token": 1,
    "readout": "mean",
    "drive_scale": 1.0,
    "learnable_gain": true,
    "learnable_region_gain": true,
    "detach_interval": 32,
    "seed": 7
  },
  "model": {
    "use_brain": true,
    "brain_gate_init": 1.0,
    "dropout": 0.0,
    "label_smoothing": 0.0,
    "z_loss": 0.0
  },
  "data": {
    "corpus": ["data/minimind/pretrain_hq.jsonl"],
    "tokenizer": "hf",
    "block_size": 512,
    "batch_size": 1,
    "eval_batch_size": 1,
    "num_workers": 0,
    "train_split": 0.98,
    "max_tokens": 0,
    "max_bytes": 104857600,
    "max_documents": 0,
    "text_field": "text",
    "cache_dir": "data/cortex_cache",
    "extensions": [".jsonl"],
    "seed": 0
  },
  "train": {
    "output_dir": "runs/cortex-qwen3-3p2-minimind",
    "max_steps": 20000,
    "lr": 2e-4,
    "brain_lr": 1e-3,
    "lora_lr": 2e-4,
    "weight_decay": 0.01,
    "betas": [0.9, 0.95],
    "warmup_steps": 500,
    "min_lr_ratio": 0.1,
    "grad_clip": 1.0,
    "grad_accum": 8,
    "amp": "bf16",
    "eval_interval": 500,
    "eval_batches": 32,
    "save_interval": 500,
    "log_interval": 10,
    "seed": 0,
    "device": "auto"
  }
}
